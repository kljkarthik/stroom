{
  "name": "stroom",
  "version": "1.0.0",
  "description": "Stroom - Premium Social Discovery App with Dynamic Vibe Quiz & Admin CMS",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "main": "server/index.ts",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run build:client && npm run build:server",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "start": "node dist/server/index.js",
    "db:backup": "tsx scripts/backup-db.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:raw": "tsx tests/run-all-tests.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "better-sqlite3": "^12.11.1",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hono": "^4.13.18",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.24",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vite": "^5.4.14",
    "wrangler": "^4.162.0"
  }
}
