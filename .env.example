# ==============================================================================
# STROOM Platform — Environment Configuration Example
# Copy to `.env` for local development or inject directly in hosting platform.
# NEVER commit `.env` with real credentials to version control.
# ==============================================================================

# Server runtime environment: development | production | test
NODE_ENV=production

# HTTP listening port
PORT=5000

# REQUIRED IN PRODUCTION: Cryptographically random secret (>= 24 characters)
# Generate locally via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_48_char_random_hex_secret_before_deploying

# Comma-separated list of allowed frontend origins in production (HTTPS)
# Leave empty ONLY if frontend is served strictly from the same domain/origin
ALLOWED_ORIGINS=https://your-stroom-domain.example.com

# Persistent SQLite database path (on PaaS like Render/Fly/Railway, point to mounted persistent volume)
DB_PATH=./data/stroom.db

# Private backup directory (MUST be outside `dist/` and `public/`)
BACKUP_DIR=./backups

# Authentication brute-force rate limit (max attempts per 15-minute window per IP)
AUTH_RATE_LIMIT_MAX=25

# Frontend Build Flag (set false or omit in production to strip one-click demo buttons)
VITE_ENABLE_DEMO_AUTH=false

# ==============================================================================
# Optional Future External Providers (currently unconfigured by default)
# ==============================================================================
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
