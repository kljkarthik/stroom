# ==============================================================================
# STROOM Platform — Comprehensive Environment Configuration Guide
# Copy to `.env` for local development or inject via hosting platform secrets.
# NEVER commit `.env` containing real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE EXPRESS BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=production

# Database driver: sqlite | postgres (strictly defaults to sqlite if omitted)
DATABASE_DRIVER=sqlite

# PostgreSQL Connection URI (required when DATABASE_DRIVER=postgres)
# DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require

# HTTP listening port
PORT=5000

# Cryptographically random JWT secret (>= 24 characters required in production).
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace_with_at_least_32_bytes_random_secret_before_deploying

# Comma-separated list of allowed frontend origins (HTTPS in production)
ALLOWED_ORIGINS=https://stroom.in,https://www.stroom.in,https://stroom.pages.dev

# Persistent SQLite database path (mounted persistent disk volume on PaaS)
DB_PATH=./data/stroom.db

# Backup directory (strictly isolated from client-accessible directories)
BACKUP_DIR=./backups

# Rate limit for authentication endpoints (requests per 15-minute window per IP)
AUTH_RATE_LIMIT_MAX=25

# ------------------------------------------------------------------------------
# 2. HYBRID D1 BRIDGE ARCHITECTURE (TRUST PATH A: Express -> Worker -> D1)
# ------------------------------------------------------------------------------
# Master feature flag controlling D1 Auth Bridge. Defaults strictly to false.
# Set to 'true' ONLY in isolated test harnesses or post-data-migration cutover.
ENABLE_D1_AUTH_BRIDGE=false

# Canonical 43-character Base64URL secret (256-bit entropy) for Express -> Worker.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_D1_BRIDGE_SECRET=replace_with_canonical_43_char_base64url_secret

# Optional Secret Rotation Variables for Bridge Secret (max 72h overlap)
# INTERNAL_D1_BRIDGE_SECRET_PREVIOUS=
# INTERNAL_D1_BRIDGE_SECRET_PREVIOUS_EXPIRES_AT=1731600000000

# Worker Edge Bridge endpoint URL (local: http://127.0.0.1:8787, prod: https://stroom.in)
D1_BRIDGE_URL=http://127.0.0.1:8787

# ------------------------------------------------------------------------------
# 3. ORIGIN REVERSE PROXY GUARD (TRUST PATH B: Worker -> Express)
# ------------------------------------------------------------------------------
# Set to 'true' in production behind Cloudflare Tunnel to reject direct origin bypass.
REQUIRE_ORIGIN_PROXY_AUTH=false

# Canonical 43-character Base64URL secret (256-bit entropy) for Worker -> Express.
# Must NOT be identical to INTERNAL_D1_BRIDGE_SECRET.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORIGIN_PROXY_SECRET=replace_with_distinct_canonical_43_char_base64url_secret

# Optional Secret Rotation Variables for Origin Proxy Secret (max 72h overlap)
# ORIGIN_PROXY_SECRET_PREVIOUS=
# ORIGIN_PROXY_SECRET_PREVIOUS_EXPIRES_AT=1731600000000

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE WORKER SECRETS & BINDINGS (Deploy via `wrangler secret put <NAME>`)
# ------------------------------------------------------------------------------
# The Worker isolate requires these secrets configured in Cloudflare Dashboard or Wrangler:
# - INTERNAL_D1_BRIDGE_SECRET: (matches Express client secret)
# - INTERNAL_D1_BRIDGE_SECRET_PREVIOUS: (optional rotation secret)
# - INTERNAL_D1_BRIDGE_SECRET_PREVIOUS_EXPIRES_AT: (optional rotation expiry timestamp in ms)
# - ORIGIN_PROXY_SECRET: (matches Express ingress guard secret)
# - ORIGIN_PROXY_SECRET_PREVIOUS: (optional rotation secret)
# - ORIGIN_PROXY_SECRET_PREVIOUS_EXPIRES_AT: (optional rotation expiry timestamp in ms)
# - ORIGIN_URL: Target internal URL for Express (e.g. https://origin-internal.stroom.in or http://127.0.0.1:5000)

# ------------------------------------------------------------------------------
# 5. FRONTEND BUILD CONFIGURATION
# ------------------------------------------------------------------------------
# Strips demo authentication buttons and debug widgets from production UI
VITE_ENABLE_DEMO_AUTH=false

# ------------------------------------------------------------------------------
# 6. EXTERNAL PROVIDERS (Optional Future Integrations)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
